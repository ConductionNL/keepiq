parameters:
    level: 5
    paths:
        - lib
    bootstrapFiles:
        - phpstan-bootstrap.php
    excludePaths:
        - vendor
    scanDirectories:
        - vendor/nextcloud/ocp
    scanFiles:
        # AppHost Settings engine (GenericSettingsSection + GenericAdminSettings)
        # so Sections\SettingsSection and Settings\AdminSettings resolve the base
        # classes they extend when the openregister sibling app is absent from the
        # analysis path. Analysis-only — never loaded at runtime (ADR-040).
        - tests/stubs/openregister-apphost.stub.php
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Nextcloud internal classes that PHPStan might not recognize
        - '#Call to an undefined method OC::#'
        - '#Class OC not found#'
        - '#Access to static property \$server on an unknown class OC#'
        # OC_App is Nextcloud's legacy bootstrap class, server-private and so
        # absent from nextcloud/ocp. There is no OCP interface for registering
        # another app's autoloader, so the ADR-040 AppHost prelude in
        # AppInfo\OpenRegisterAutoloader must call it directly.
        - '#unknown class OC_App#'
        - '#Class OC_App not found#'
        # OCA classes from other apps (OpenRegister) not available during static analysis
        - '#unknown class OCA\\OpenRegister\\#'
        - '#OCA\\OpenRegister\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\OpenRegister\\#'
        - '#has invalid return type OCA\\OpenRegister\\#'
        # Doctrine\DBAL classes (used in migrations for cross-dialect column type changes;
        # not in vendor stubs because doriath doesn't directly require doctrine/dbal — it
        # comes through Nextcloud's runtime via OCP\DB\Types).
        - '#unknown class Doctrine\\DBAL\\#'
        - '#class Doctrine\\DBAL\\#'
        - '#Class Doctrine\\DBAL\\#'
        - '#Doctrine\\DBAL\\Platforms\\#'
        # GuzzleHttp is available at runtime via Nextcloud but not in composer require
        - '#unknown class GuzzleHttp\\#'
        - '#GuzzleHttp\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class GuzzleHttp\\#'
        - '#invalid type GuzzleHttp\\#'
        - '#Caught class GuzzleHttp\\#'
        # Dynamic HTTP status codes from business rule validation results
        - '#Parameter \$statusCode of class OCP\\AppFramework\\Http\\JSONResponse constructor expects#'
        # nextcloud/ocp declares DataResponse's body bound as
        #   `@psalm-type DataResponseType = array|int|float|string|bool|object|null|…`
        #   `@template-covariant T of DataResponseType`
        # `@psalm-type` is a Psalm-only alias — PHPStan cannot resolve it, so the
        # template bound degrades to an unresolvable type and EVERY `array` body is
        # reported as a non-matching template argument even though `array` is
        # explicitly IN DataResponseType. Verified false positive: the identical
        # error appears with both named and positional arguments, and Psalm (which
        # does understand the alias) reports nothing. Same documented ignore already
        # ships in larpingapp, shillinq and launchpad.
        - '#Parameter (\#\d+ )?\$data of class OCP\\AppFramework\\Http\\DataResponse constructor expects#'
        # registerRepairStep exists on server; not yet in nextcloud/ocp stub used for analysis
        - '#Call to an undefined method OCP\\AppFramework\\Bootstrap\\IRegistrationContext::registerRepairStep#'
        # Entities use string UUIDs as primary keys instead of auto-increment ints;
        # getId() returns int per OCP\Entity but the actual value is a UUID string at runtime
        - '#Parameter \#1 \$id of method OCP\\AppFramework\\Db\\Entity::setId\(\) expects int, string given#'
        - '#expects string(\|null)?, int given#'
        # Companion of the setId ignore above: the entity overrides $id with a string
        # PHPDoc type which PHPStan flags as non-covariant against OCP\Entity::$id (int).
        # Same UUID-PK rationale.
        - '#PHPDoc type string of property OCA\\Doriath\\Db\\[A-Za-z]+::\$id is not covariant with PHPDoc type int of overridden property OCP\\AppFramework\\Db\\Entity::\$id#'
        # str_split with positive chunk size always returns non-empty array
        - '#Variable \$chunks in empty\(\) always exists and is not falsy#'
        - '#Strict comparison using === between false and true will always evaluate to false#'
        # PHPDoc type refinement: nullable DateTime checked at runtime
        - '#Strict comparison using === between DateTime and null will always evaluate to false#'
