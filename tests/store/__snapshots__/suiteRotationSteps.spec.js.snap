          {
            "granteeUserId": "g",
            "reason": "r",
          },
        ],
      },
      {
        "X-Proof": "{"suiteId":"old-suite","purpose":"complete-migration","encryptedPrivateKey":"OLD-WRAPPED-SERVER","masterPassword":"old-pw","boundValues":["m1","1",""]}",
      },
    ],
  ],
  "outcome": {
    "failed": 1,
    "failures": [],
    "migrated": 3,
    "residualContacts": [
      {
        "granteeUserId": "g",
        "reason": "r",
      },
    ],
  },
  "post": [
    [
      "/apps/keepiq/api/v1/suites/compromise-recovery",
      {
        "encryptedPrivateKey": "WRAP(192|new-pw)",
        "publicKey": "PUB",
      },
      {
        "headers": {
          "X-Proof": "{"suiteId":"old-suite","purpose":"compromise-recovery","encryptedPrivateKey":"OLD-WRAPPED","masterPassword":"old-pw","boundValues":["PUB","WRAP(192|new-pw)"]}",
