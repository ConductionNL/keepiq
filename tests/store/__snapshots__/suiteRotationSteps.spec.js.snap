  ],
  "session": {
    "active": "number",
    "certificate": "NEW-CERT",
    "cryptoKey": "KEY(192)",
    "encryptedPrivateKey": "WRAP(192|new-pw)",
    "suiteId": "new-suite",
  },
  "status": {
    "id": "m1",
    "oldSuiteId": "old-suite",
