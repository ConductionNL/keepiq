					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('anonymous write rejected 401', () => pm.response.to.have.status(401));" ] } } ],
					"request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"anon\",\n  \"key\": \"anon\"\n}" }, "url": { "raw": "{{noAuthBase}}/index.php/apps/doriath/api/v1/secrets", "host": [ "{{noAuthBase}}" ], "path": [ "index.php", "apps", "doriath", "api", "v1", "secrets" ] } }
