		{
			"name": "4. Public link-share access (no NC auth)",
			"item": [
				{
					"name": "Public show ERROR: unknown token -> 404 not 500 (route reachable without auth)",
					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
						"// The public two-phase link-share route is intentionally unauthenticated",
						"// (#[PublicPage]). An unknown token is rejected 404 — the route is reachable",
						"// (not 401/303 to login) and does not 500.",
						"pm.test('unknown token -> 404', () => pm.response.to.have.status(404));",
						"pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));",
						"pm.test('not a 401 (public route)', () => pm.expect(pm.response.code).to.not.eql(401));"
					] } } ],
					"request": { "method": "GET", "header": [ { "key": "Accept", "value": "application/json" } ], "url": { "raw": "{{noAuthBase}}/index.php/apps/doriath/api/v1/public/link-shares/newman-unknown-token", "host": [ "{{noAuthBase}}" ], "path": [ "index.php", "apps", "doriath", "api", "v1", "public", "link-shares", "newman-unknown-token" ] } }
				}
			]
		},
		{
