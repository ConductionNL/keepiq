exports[`folder dialogs name field (golden) > create, folder level 1`] = `
{
  "empty": "<div class="folder-form"><input aria-label="Folder name" data-required="true" value=""><div class="select" modelvalue="v-1" reduce="(opt) => opt.value" clearable="false"></div></div>",
  "typedName": "Renamed",
  "withError": "<div class="folder-form"><p class="note" data-type="error">Duplicate name</p><input aria-label="Folder name" data-required="true" value="Renamed"><div class="select" modelvalue="v-1" reduce="(opt) => opt.value" clearable="false"></div></div>",
}
`;

