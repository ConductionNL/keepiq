// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`KeepiqAppNav manifest entries (golden) > renders the main, footer and settings entries 1`] = `"<nav aria-label="Keepiq navigation" data-testid="cn-nav"><ul class="list"><li data-name="All secrets" data-to="{&quot;name&quot;:&quot;secrets&quot;}" data-active="false" data-testid="cn-nav-entry-Secrets" data-cn-route="secrets"><i data-icon="Key"></i></li><li class="caption" data-name="Tools" data-testid="cn-nav-caption-Tools"></li><li data-name="Password health" data-to="{&quot;name&quot;:&quot;health&quot;}" data-active="true" data-testid="cn-nav-entry-Health" data-cn-route="health"></li><li class="caption" data-name="Vaults" data-testid="cn-nav-caption-FoldersCaption"></li><li data-name="New vault" data-active="undefined" data-testid="nav-vault-new"><i data-icon="Plus" size="20"></i></li></ul><div class="footer"><ul class="cn-app-nav__footer-list"><li data-name="Documentation" data-href="https://docs.example.org" data-active="false" data-testid="cn-nav-entry-Docs"><i data-icon="BookOpen"></i></li></ul><div class="settings" data-testid="cn-nav-settings"><ul class="cn-app-nav__settings-list"><li data-name="Personal settings" data-active="false" data-testid="cn-nav-entry-Personal"><i data-icon="Cog"></i></li><li data-name="Integrations" data-to="{&quot;name&quot;:&quot;integrations&quot;,&quot;query&quot;:{&quot;app&quot;:&quot;keepiq&quot;}}" data-active="false" data-testid="cn-nav-entry-Integrations" data-cn-route="integrations"></li></ul></div></div></nav>"`;
