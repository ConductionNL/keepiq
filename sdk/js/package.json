{
  "name": "@conduction/keepiq-sdk",
  "version": "0.1.0",
  "description": "Client library for the Keepiq machine API: read and write an application's secrets, decrypted only in your process.",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": ["lib", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConductionNL/keepiq.git",
    "directory": "sdk/js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
