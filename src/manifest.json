{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Vault",
			"label": "Vault",
			"icon": "icon-password",
			"route": "SecretList",
			"order": 20
		},
		{
			"id": "ApplicationsMenu",
			"label": "Applications",
			"icon": "icon-category-integration",
			"route": "ApplicationRegister",
			"order": 30
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://doriath.conduction.nl",
			"section": "footer",
			"order": 80
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 85
		},
		{
			"id": "LockVault",
			"label": "Lock vault",
			"icon": "icon-password",
			"route": "Lock",
			"section": "settings",
			"order": 90
		},
		{
			"id": "UserSettings",
			"label": "Settings",
			"icon": "icon-settings",
			"action": "user-settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Vault overview",
			"config": {
				"description": "Your secrets, folders and applications at a glance",
				"documentationUrl": "https://doriath.conduction.nl"
			},
			"widgets": [
				{
					"widgetKey": "stat",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"content": {
							"label": "Secrets",
							"icon": "M7 14C5.9 14 5 13.1 5 12S5.9 10 7 10 9 10.9 9 12 8.1 14 7 14M12.6 10C11.8 7.7 9.6 6 7 6C3.7 6 1 8.7 1 12S3.7 18 7 18C9.6 18 11.8 16.3 12.6 14H16V18H20V14H23V10H12.6Z",
							"valueColor": "#21468B",
							"format": { "style": "number", "decimals": 0 },
							"source": {
								"kind": "endpoint",
								"url": "/apps/doriath/api/dashboard/summary",
								"path": "total_secrets"
							},
							"route": { "name": "SecretList" }
						}
					}
				},
				{
					"widgetKey": "stat",
					"slot": "body",
					"gridX": 3,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"content": {
							"label": "Folders",
							"icon": "M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z",
							"valueColor": "#21468B",
							"format": { "style": "number", "decimals": 0 },
							"source": {
								"kind": "endpoint",
								"url": "/apps/doriath/api/dashboard/summary",
								"path": "folders_count"
							},
							"route": { "name": "SecretList" }
						}
					}
				},
				{
					"widgetKey": "stat",
					"slot": "body",
					"gridX": 6,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"content": {
							"label": "Shared with me",
							"icon": "M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z",
							"valueColor": "#21468B",
							"format": { "style": "number", "decimals": 0 },
							"source": {
								"kind": "endpoint",
								"url": "/apps/doriath/api/dashboard/summary",
								"path": "shared_with_me_count"
							}
						}
					}
				},
				{
					"widgetKey": "stat",
					"slot": "body",
					"gridX": 9,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"content": {
							"label": "Pending approvals",
							"icon": "M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z",
							"valueColor": "#21468B",
							"format": { "style": "number", "decimals": 0 },
							"source": {
								"kind": "endpoint",
								"url": "/apps/doriath/api/dashboard/summary",
								"path": "pending_apps_count"
							},
							"route": { "name": "ApplicationRegister" }
						}
					}
				},
				{
					"widgetKey": "tile",
					"slot": "body",
					"gridX": 0,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"props": {
						"content": {
							"title": "New secret",
							"icon": "icon-add",
							"iconType": "class",
							"backgroundColor": "#21468B",
							"textColor": "#ffffff",
							"linkType": "app",
							"linkValue": "/apps/doriath/secrets"
						}
					}
				},
				{
					"widgetKey": "tile",
					"slot": "body",
					"gridX": 4,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"props": {
						"content": {
							"title": "Register application",
							"icon": "icon-category-integration",
							"iconType": "class",
							"backgroundColor": "#3b82f6",
							"textColor": "#ffffff",
							"linkType": "app",
							"linkValue": "/apps/doriath/applications"
						}
					}
				},
				{
					"widgetKey": "tile",
					"slot": "body",
					"gridX": 8,
					"gridY": 2,
					"gridWidth": 4,
					"gridHeight": 2,
					"props": {
						"content": {
							"title": "Documentation",
							"icon": "icon-info",
							"iconType": "class",
							"backgroundColor": "#6b7280",
							"textColor": "#ffffff",
							"linkType": "url",
							"linkValue": "https://doriath.conduction.nl"
						}
					}
				}
			]
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://doriath.conduction.nl"
			}
		},
		{
			"id": "Lock",
			"route": "/lock",
			"type": "custom",
			"title": "Unlock Doriath",
			"component": "LockScreen",
			"_note": "Master-password setup + unlock flow. Cannot use a built-in page type because the lock screen owns its own full-page layout (no app nav / header / sidebar) and gates router navigation via App.vue's lock-redirect watcher. Stays type:\"custom\" until the lib gains a dedicated unlock-page primitive."
		},
		{
			"id": "SecretList",
			"route": "/secrets",
			"type": "custom",
			"title": "Vault",
			"component": "SecretList",
			"_note": "Main vault: folder sidebar + searchable/sortable/paginated secret list. type:\"custom\" because it owns a bespoke two-pane layout and on-demand client-side decryption that no built-in page type models yet."
		},
		{
			"id": "SecretListFolder",
			"route": "/folders/:folderId",
			"type": "custom",
			"title": "Vault",
			"component": "SecretList",
			"_note": "Same vault view filtered to a folder (folderId route param)."
		},
		{
			"id": "SecretDetail",
			"route": "/secrets/:id",
			"type": "custom",
			"title": "Secret",
			"component": "SecretDetail",
			"_note": "Secret detail with type-specific fields, decrypted client-side; show/hide toggle keeps the key masked until revealed."
		},
		{
			"id": "ApplicationRegister",
			"route": "/applications",
			"type": "custom",
			"title": "Applications",
			"component": "ApplicationRegisterView",
			"_note": "Developer-facing app registration page. Owner sees their own apps + can register new ones; admin queue lives on AdminApplicationsView under settings."
		},
		{
			"id": "ApplicationDetail",
			"route": "/applications/:id",
			"type": "custom",
			"title": "Application",
			"component": "ApplicationDetail",
			"_note": "Per-application detail page. Shows metadata, EncryptionSuite info, application-attributed secrets list, and the write-secret-for-app dialog. Owner sees own + active; admin sees all (server enforces)."
		},
		{
			"id": "SecretRequestFill",
			"route": "/share/request/:token",
			"type": "custom",
			"title": "Fill in secret",
			"component": "SecretRequestFill",
			"_note": "Public fill-in page (no auth). The lock-screen redirect guard in App.vue exempts this route by name — see PUBLIC_ROUTE_NAMES — so an external recipient can complete the flow without a Nextcloud account; the controller runs as #[PublicPage]."
		},
		{
			"id": "LinkShareAccess",
			"route": "/share/link/:token",
			"type": "custom",
			"title": "Shared secret",
			"component": "LinkShareAccess",
			"_note": "Public link-share access page (no auth). The lock-screen redirect guard in App.vue exempts this route by name — see PUBLIC_ROUTE_NAMES — so an external recipient can complete the password-protected flow without a Nextcloud account; the LinkShareAccessController endpoints run as #[PublicPage]. Implements the two-phase recipient protocol: Phase 1 fetches the ciphertext + Argon2id salt; Phase 2 confirms a successful client-side decrypt so the server can increment the usage count and auto-delete on cap."
		}
	]
}
