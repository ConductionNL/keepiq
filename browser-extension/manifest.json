{
  "manifest_version": 3,
  "name": "Keepiq",
  "version": "0.1.0",
  "description": "Fill logins, one-time codes and passkeys from your Keepiq vault. It opens in the extension, so your server only sees encrypted data.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "idle",
    "windows"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Keepiq"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content-script.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage-shim.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
