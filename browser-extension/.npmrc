# Don't install a dependency version that is less than a week old — a
# supply-chain-attack cooldown. `min-release-age` is npm's spelling and takes
# DAYS; `minimum-release-age` is pnpm/bun's and takes minutes. Using the wrong
# one makes npm 11 warn "Unknown project config" on every command.
#
# Symptom when a range only matches versions newer than the cooldown: ERESOLVE
# with `found <pkg>@undefined`. That is this setting, not a broken tree — widen
# the range downwards rather than reaching for --force.
min-release-age=7
save-exact=true
